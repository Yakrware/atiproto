          "properties": {
            "uri": {
              "description": "Subscription record URI",
              "format": "at-uri",
              "type": "string"
            },
            "cid": {
              "description": "Subscription record CID",
              "format": "cid",
              "type": "string"
            },
            "record": {
              "description": "The subscription record data",
              "type": "ref",
              "ref": "com.atiproto.subscription"
            }
          },
          "required": ["uri", "cid", "record"],
          "type": "object"
        }
      },
      "type": "query"
    }
  },
  "id": "com.atiproto.feed.subscription.get",
  "lexicon": 1
