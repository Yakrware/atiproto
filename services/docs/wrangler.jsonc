{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atiproto-docs",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "routes": [
    { "pattern": "*atiproto.com/docs/*", "zone_name": "atiproto.com" },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {},
  "env": {
    "test": {
      "name": "atiproto-docs-test",
    },
  },
}
