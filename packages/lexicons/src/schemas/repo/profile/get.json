{
  "lexicon": 1,
  "id": "com.atiproto.repo.profile.get",
  "defs": {
    "main": {
      "type": "query",
      "description": "Look up public profile information for any user",
      "parameters": {
        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did",
            "description": "DID of the user to look up"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "profile"],
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "User's DID"
            },
            "profile": {
              "type": "ref",
              "ref": "com.atiproto.profile#view",
              "description": "Public profile data"
            },
            "brokers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              },
              "description": "Ordered list of the user's preferred broker DIDs. Server-derived: the PoS reads the user's DID document, filters `service[]` entries with `type: \"PaymentBroker\"`, and returns each entry's DID (the portion of `id` before `#payment-broker`). First broker that accepts the payment processes it."
            }
          }
        }
      }
    }
  }
}
