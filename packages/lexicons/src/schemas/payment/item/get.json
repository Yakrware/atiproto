{
  "lexicon": 1,
  "id": "com.atiproto.payment.item.get",
  "defs": {
    "main": {
      "type": "query",
      "description": "Hydrate an item record by uri. The authenticated user must be the sender. Search filters that were previously on this endpoint live on `payment.item.list`.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "URI of the item record."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["item"],
          "properties": {
            "item": {
              "type": "ref",
              "ref": "com.atiproto.item#view"
            }
          }
        }
      }
    }
  }
}
