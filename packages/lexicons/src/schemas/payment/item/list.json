{
  "lexicon": 1,
  "id": "com.atiproto.payment.item.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List items sent by the authenticated user.",
      "parameters": {
        "type": "params",
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "Optional. Mirror of the item's `subject` union: pass an at-uri to a specific record (matches items whose `subject` is that record), or pass `at://did:plc:...` (a repo-level at-uri) to match items whose `subject` is a `#userRef` carrying that DID."
          },
          "cursor": {
            "type": "string",
            "maxLength": 512,
            "description": "Pagination cursor"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Results per page (1-100, default: 50)"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.atiproto.item#view"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 512,
              "description": "Pagination cursor for next page"
            }
          }
        }
      }
    }
  }
}
