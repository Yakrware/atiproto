{
  "lexicon": 1,
  "id": "com.atiproto.cart",
  "defs": {
    "main": {
      "type": "record",
      "description": "A record representing a shopping cart for items/subscriptions",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "items",
          "currency",
          "total",
          "status",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#cartItem"
            }
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "description": "ISO 4217 currency code"
          },
          "total": {
            "type": "integer",
            "description": "Total amount in cents"
          },
          "status": {
            "type": "string",
            "maxLength": 64,
            "enum": ["open", "completed", "expired", "abandoned"],
            "description": "Cart status"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Creation timestamp"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime",
            "description": "Expiration timestamp"
          },
          "completedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Completion timestamp"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "description": "View of a cart record for use in API responses",
      "required": [
        "uri",
        "items",
        "currency",
        "total",
        "status",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the cart record"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#cartItem"
          }
        },
        "currency": {
          "type": "string",
          "maxLength": 3,
          "description": "ISO 4217 currency code"
        },
        "total": {
          "type": "integer",
          "description": "Total amount in cents"
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "enum": ["open", "completed", "expired", "abandoned"],
          "description": "Cart status"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime",
          "description": "Creation timestamp"
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime",
          "description": "Expiration timestamp"
        },
        "completedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Completion timestamp"
        }
      }
    },
    "cartItem": {
      "type": "object",
      "required": ["type", "recordUri"],
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 128,
          "description": "Type of cart item: item or subscription",
          "enum": ["com.atiproto.item", "com.atiproto.subscription"]
        },
        "recordUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI for item on record"
        }
      }
    }
  }
}
