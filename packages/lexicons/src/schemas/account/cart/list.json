{
  "lexicon": 1,
  "id": "com.atiproto.account.cart.list",
  "defs": {
    "main": {
      "type": "query",
      "description": "List carts for the authenticated user",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter: open, completed, expired, abandoned"
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor"
            },
            "limit": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100,
              "description": "Results per page (1-100, default: 20)"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "carts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#cartResponse"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor for next page"
            }
          },
          "required": ["carts"]
        }
      }
    },
    "cartResponse": {
      "type": "object",
      "required": ["uri", "cid", "record"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the cart record"
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "CID of the cart record"
        },
        "record": {
          "type": "ref",
          "ref": "com.atiproto.cart"
        }
      }
    }
  }
}
