{
  "name": "@atiproto/lexicons",
  "version": "0.7.2",
  "description": "ATProto lexicon types and utilities",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:lexicons": "lex build --lexicons ./src/schemas --out ./src/lexicons --clear --indexFile",
    "build": "npm run build:lexicons && tsup && tsc --emitDeclarationOnly --declaration --composite false --incremental false",
    "prepack": "npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yakrware/atiproto.git",
    "directory": "packages/lexicons"
  },
  "homepage": "https://atiproto.com/docs/lexicon",
  "bugs": "https://github.com/Yakrware/atiproto/issues",
  "license": "MIT",
  "dependencies": {
    "@atproto/lex": "^0.0.23"
  },
  "devDependencies": {
    "@atproto/lexicon": "^0.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
