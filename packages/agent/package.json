{
  "name": "@atiproto/agent",
  "version": "0.5.1",
  "description": "ATProto agent",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yakrware/atiproto.git",
    "directory": "packages/agent"
  },
  "homepage": "https://atiproto.com/docs/get-started",
  "bugs": "https://github.com/Yakrware/atiproto/issues",
  "license": "MIT",
  "dependencies": {
    "@atiproto/lexicons": "*",
    "@atproto/api": "^0.19.6",
    "@atproto/xrpc": "^0.7.7"
  },
  "devDependencies": {
    "@atproto/lex": "^0.0.23",
    "@vitest/coverage-v8": "^4.1.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
