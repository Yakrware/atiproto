{
  "name": "@atiproto/edge-resolver-cache",
  "version": "0.0.1",
  "description": "Tiered edge cache (Cache API + in-memory) for ATProto DID and handle resolvers on Cloudflare Workers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@atproto-labs/simple-store": "^0.3.0",
    "@atproto-labs/simple-store-memory": "^0.1.4"
  },
  "devDependencies": {
    "@atproto/did": "^0.3.0",
    "@cloudflare/workers-types": "^4.20260411.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
